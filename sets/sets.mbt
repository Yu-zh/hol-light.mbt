///|
/// DELETE_INSERT
fn step_161() -> Unit raise {
  let t223 = set_tac(@list.List([]))
  let t222 = @tactics.pop_assum(fn(
    x219 : @kernel.Thm,
  ) -> (((@list.List[(String, @kernel.Thm)], @kernel.Term)) -> (
    (
      @list.List[@kernel.Term],
      (
        @list.List[(Int64, @kernel.Term)],
        @list.List[(@kernel.Term, @kernel.Term)],
        @list.List[(@kernel.HolType, @kernel.HolType)],
      ),
    ),
    @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
    (
      (
        @list.List[(Int64, @kernel.Term)],
        @list.List[(@kernel.Term, @kernel.Term)],
        @list.List[(@kernel.HolType, @kernel.HolType)],
      ),
      @list.List[@kernel.Thm],
    ) -> @kernel.Thm raise,
  ) raise) raise {
    let s220 = @tactics.mp_tac(x219)
    fn(
      x221 : (@list.List[(String, @kernel.Thm)], @kernel.Term),
    ) -> (
      (
        @list.List[@kernel.Term],
        (
          @list.List[(Int64, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
      ),
      @list.List[(@list.List[(String, @kernel.Thm)], @kernel.Term)],
      (
        (
          @list.List[(Int64, @kernel.Term)],
          @list.List[(@kernel.Term, @kernel.Term)],
          @list.List[(@kernel.HolType, @kernel.HolType)],
        ),
        @list.List[@kernel.Thm],
      ) -> @kernel.Thm raise,
    ) raise {
      s220(x221)
    }
  })
  let t224 = @tactics.then_tac(
    @tactics.then_tac(
      @tactics.then_tac(
        @tactics.repeat_tac(@tactics.gen_tac),
        @class.cond_cases_tac,
      ),
      t222,
    ),
    t223,
  )
  delete_insert_c.set(
    @tactics.prove(
      @term_syntax.parse_term("∀ x : A, ∀ y : A, ∀ s : (A) -> Bool, DELETE(INSERT(x, s), y) == (if x == y { DELETE(s, y) } else { INSERT(x, DELETE(s, y)) })"),
      t224,
    ),
  )
}

