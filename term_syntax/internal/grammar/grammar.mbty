// HOL terms in a subset of MoonBit's expression syntax. Rule names, shapes
// and precedences follow moonbitlang/parser's yacc_parser/parser.mbty, so a
// term is also a MoonBit expression and parses the same way. Two documented
// deviations: identifiers may end in primes (x'), and binders may be
// capitalised (P), as HOL's variables are; a variable with a symbolic name
// no identifier spells is written between backticks (`<<`, a RAWIDENT). HOL's patterns are written as
// MoonBit's: `match e { p => a; q if c => b }`, `fn { p => a; q => b }` (a
// function by cases) and, for a lambda or quantifier over a pattern,
// `fn { (a, b) => e }` and `∀ (a, b) : (A, B), e`. Regenerate grammar.mbt with
//   moonx moonbitlang/yacc@0.7.25 --no-comments grammar.mbty -o grammar.mbt
%position<Int>
%derive<Debug> Token
%derive<Debug> ParseError

%start term
%start pretype
%start type_definition

%token<String> LIDENT
%token<String> UIDENT
%token<String> RAWIDENT
%token<String> VERBATIM
%token<String> INT
%token<String> INFIX1
%token<String> INFIX3
%token<String> DOT_LIDENT
%token TRUE "true"
%token FALSE "false"
%token IF "if"
%token ELSE "else"
%token FN "fn"
%token MATCH "match"
%token ENUM "enum"
%token FORALL "∀"
%token EXISTS "∃"
%token IMPLIES "→"
%token BARBAR "||"
%token BAR "|"
%token AMPERAMPER "&&"
%token PLUS "+"
%token MINUS "-"
%token STAR "*"
%token EXCLAMATION "!"
%token LPAREN "("
%token RPAREN ")"
%token LBRACKET "["
%token RBRACKET "]"
%token LBRACE "{"
%token RBRACE "}"
%token COMMA ","
%token COLON ":"
%token SEMI ";"
%token FAT_ARROW "=>"
%token THIN_ARROW "->"
%token UNDERSCORE "_"
%token EOF

%right IMPLIES
%right BARBAR
%right AMPERAMPER
%left INFIX1
%left PLUS MINUS
%left STAR INFIX3
%nonassoc prec_apply_non_ident_fn
%nonassoc ","
%nonassoc ")"
%nonassoc ":"

%%

term -> @preterm.Preterm
  : expr EOF { $1 }
  ;

pretype -> @preterm.Pretype
  : type_ EOF { $1 }
  ;

// an inductive type definition (ind_types' define_type) as MoonBit enums:
// `enum Tree { Leaf(Num); Node(Tree, Tree) }`, mutually recursive types one
// enum after another
type_definition -> @list.List[(String, String, @list.List[(String, @list.List[@preterm.Pretype])])]
  : enum_decls EOF { $1 }
  ;

enum_decls -> @list.List[(String, String, @list.List[(String, @list.List[@preterm.Pretype])])]
  : enum_decl { @list.singleton($1) }
  | enum_decl enum_decls { $2.prepend($1) }
  ;

// (the HOL type's name, the type variable its constructors refer to it by,
// constructors): `enum Tree` defines tree; a name between backticks is the
// HOL name verbatim, for one that starts with a capital (enum `Term`)
enum_decl -> (String, String, @list.List[(String, @list.List[@preterm.Pretype])])
  : "enum" UIDENT "{" enum_constructors "}" { (lowered($2), defined_type_var($2), $4) }
  | "enum" VERBATIM "{" enum_constructors "}" { ($2, defined_type_var("`" + $2 + "`"), $4) }
  ;

// constructors are separated by `;`, as match arms are
enum_constructors -> @list.List[(String, @list.List[@preterm.Pretype])]
  : enum_constructor option(";") { @list.singleton($1) }
  | enum_constructor ";" enum_constructors { $3.prepend($1) }
  ;

// a constructor named like a keyword is written between backticks (`module`)
enum_constructor -> (String, @list.List[@preterm.Pretype])
  : constructor_name { ($1, @list.List([])) }
  | constructor_name "(" non_empty_list_commas(type_) ")" { ($1, $3) }
  ;

constructor_name -> String
  : binder { $1 }
  | VERBATIM { $1 }
  ;

expr -> @preterm.Preterm
  : if_expr { $1 }
  | quantifier_expr { $1 }
  | arrow_fn_expr { $1 }
  | infix_expr { $1 }
  ;

block_expr -> @preterm.Preterm
  : "{" expr "}" { $2 }
  ;

if_expr -> @preterm.Preterm
  : "if" infix_expr block_expr "else" block_expr { cond($2, $3, $5) }
  | "if" infix_expr block_expr "else" if_expr { cond($2, $3, $5) }
  ;

quantifier_expr -> @preterm.Preterm
  : "∀" binder ":" type_ "," quantifier_body_expr { quantify("forall", $2, $4, $6) }
  | "∃" binder ":" type_ "," quantifier_body_expr { quantify("?", $2, $4, $6) }
  | "∀" tuple_expr ":" type_ "," quantifier_body_expr { quantify_pattern("forall", $2, $4, $6) }
  | "∃" tuple_expr ":" type_ "," quantifier_body_expr { quantify_pattern("?", $2, $4, $6) }
  ;

quantifier_body_expr -> @preterm.Preterm
  : quantifier_expr { $1 }
  | infix_expr { $1 }
  ;

arrow_fn_expr -> @preterm.Preterm
  : "(" arrow_fn_prefix "=>" expr { lambdas($2, $4) }
  | binder "=>" expr { lambdas(@list.singleton(($1, None)), $3) }
  ;

arrow_fn_prefix -> @list.List[(String, @preterm.Pretype?)]
  : binder ioption(",") ")" { @list.singleton(($1, None)) }
  | binder ":" type_ ioption(",") ")" { @list.singleton(($1, Some($3))) }
  | binder "," arrow_fn_prefix { $3.prepend(($1, None)) }
  | binder ":" type_ "," arrow_fn_prefix { $5.prepend(($1, Some($3))) }
  ;

arrow_fn_prefix_no_constraint -> @list.List[String]
  : binder ioption(",") ")" { @list.singleton($1) }
  | binder "," arrow_fn_prefix_no_constraint { $3.prepend($1) }
  ;

infix_expr -> @preterm.Preterm
  : infix_expr "→" infix_expr { binary("==>", $1, $3) }
  | infix_expr "||" infix_expr { binary("\\/", $1, $3) }
  | infix_expr "&&" infix_expr { binary("/\\", $1, $3) }
  | infix_expr INFIX1 infix_expr { comparison($2, $1, $3) }
  | infix_expr "+" infix_expr { binary("+", $1, $3) }
  | infix_expr "-" infix_expr { binary("-", $1, $3) }
  | infix_expr "*" infix_expr { binary("*", $1, $3) }
  | infix_expr INFIX3 infix_expr { infix3($2, $1, $3) }
  | prefix_expr { $1 }
  ;

prefix_expr -> @preterm.Preterm
  : "-" prefix_expr { apply(pconst("--"), $2) }
  | "!" prefix_expr { apply(pconst("~"), $2) }
  | simple_expr { $1 }
  ;

tuple_expr -> @preterm.Preterm
  : "(" arrow_fn_prefix_no_constraint { tuple($2.map(pvar)) }
  | "(" non_empty_tuple_elems_with_prefix { tuple($2) }
  | "(" binder ":" type_ ")" { typed(pvar($2), $4) }
  | "(" expr ":" type_ ")" { typed($2, $4) }
  ;

non_empty_tuple_elems -> @list.List[@preterm.Preterm]
  : expr ioption(",") ")" { @list.singleton($1) }
  | expr "," non_empty_tuple_elems { $3.prepend($1) }
  ;

non_empty_tuple_elems_with_prefix -> @list.List[@preterm.Preterm]
  : binder "," non_empty_tuple_elems_with_prefix { $3.prepend(pvar($1)) }
  | non_empty_tuple_elems { $1 }
  ;

simple_expr -> @preterm.Preterm
  : atomic_expr { $1 }
  | UIDENT %prec prec_apply_non_ident_fn { pvar($1) }
  | LIDENT %prec prec_apply_non_ident_fn { pvar($1) }
  | RAWIDENT %prec prec_apply_non_ident_fn { pvar($1) }
  | tuple_expr { $1 }
  | "[" list_commas(expr) "]" { list($2) }
  | "{" "}" { pconst("EMPTY") }
  | "{" non_empty_list_commas(expr) "}" { set_enum($2) }
  | "{" expr "|" expr "}" { set_abs($2, $4) }
  | "{" expr "|" non_empty_list_commas(set_binder) "|" expr "}" { set_compr($2, $4, $6) }
  | "fn" "{" match_arms "}" { function($3) }
  | "match" infix_expr "{" match_arms "}" { match_cases($2, $4) }
  | simple_expr "(" non_empty_list_commas(expr) ")" { applies($1, $3) }
  | simple_expr DOT_LIDENT "(" list_commas(expr) ")" { applies(pvar($2), $4.prepend($1)) }
  ;

atomic_expr -> @preterm.Preterm
  : "true" { pconst("T") }
  | "false" { pconst("F") }
  | INT { pvar($1) }
  ;

// arms are separated by `;` (a newline is only whitespace); a body is an
// expression, which no `;` or `}` can end inside, so it cannot take in the
// next arm
match_arms -> @list.List[@preterm.Preterm]
  : match_arm option(";") { @list.singleton($1) }
  | match_arm ";" match_arms { $3.prepend($1) }
  ;

match_arm -> @preterm.Preterm
  : infix_expr "=>" expr { clause($1, None, $3) }
  | infix_expr "if" infix_expr "=>" expr { clause($1, Some($3), $5) }
  ;

set_binder -> (String, @preterm.Pretype)
  : binder ":" type_ { ($1, $3) }
  ;

%inline binder -> String
  : LIDENT { $1 }
  | UIDENT { $1 }
  | RAWIDENT { $1 }
  ;

non_empty_list_commas_rev[T](X : T) -> @list.List[T]
  : X { @list.singleton($1) }
  | non_empty_list_commas_rev(X) "," X { $1.prepend($3) }
  ;

non_empty_list_commas[T](X : T) -> @list.List[T]
  : non_empty_list_commas_rev(X) option(",") { $1.rev() }
  ;

list_commas[T](X : T) -> @list.List[T]
  : { @list.List([]) }
  | non_empty_list_commas(X) { $1 }
  ;

simple_type -> @preterm.Pretype
  : "(" type_ "," non_empty_list_commas(type_) ")" { tuple_type($4.prepend($2)) }
  | "(" type_ ")" { $2 }
  | UIDENT optional_type_arguments { named_type($1, $2) }
  | VERBATIM optional_type_arguments { verbatim_type($1, $2) }
  | INT { finite_type($1) }
  | "_" { @preterm.dpty }
  ;

optional_type_arguments -> @list.List[@preterm.Pretype]
  : "[" non_empty_list_commas(type_) "]" { $2 }
  | { @list.List([]) }
  ;

type_ -> @preterm.Pretype
  : simple_type { $1 }
  | "(" type_ "," non_empty_list_commas(type_) ")" "->" type_ { fun_type($4.prepend($2), $7) }
  | "(" type_ ")" "->" type_ { fun_type(@list.singleton($2), $5) }
  ;
