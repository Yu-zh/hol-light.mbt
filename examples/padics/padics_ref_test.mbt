// Load-fidelity test for Examples/padics.ml: replays tools/ocaml_ref/Examples_padics_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Examples/padics matches Examples/padics.ml" {
  @padics.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/prime", "Library/wo", "Library/card", "Library/floor", "Multivariate/misc",
      "Library/products", "Library/iter", "Multivariate/metric", "Examples/padics",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Examples/padics")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("qnorm_def", () => sthm(@padics.qnorm_def()))
  log.attempt("QNORM_EQ_0", () => sthm(@padics.qnorm_eq_0()))
  log.attempt("QNORM_ABS", () => sthm(@padics.qnorm_abs()))
  log.attempt("qnorm", () => sthm(@padics.qnorm()))
  log.attempt("QNORM_NEG", () => sthm(@padics.qnorm_neg()))
  log.attempt("QNORM_0", () => sthm(@padics.qnorm_0()))
  log.attempt("QNORM_MUL", () => sthm(@padics.qnorm_mul()))
  log.attempt("QNORM_1", () => sthm(@padics.qnorm_1()))
  log.attempt("QNORM_INV", () => sthm(@padics.qnorm_inv()))
  log.attempt("QNORM_POS_LE", () => sthm(@padics.qnorm_pos_le()))
  log.attempt("QNORM_POS_LT", () => sthm(@padics.qnorm_pos_lt()))
  log.attempt("QNORM_ULTRA", () => sthm(@padics.qnorm_ultra()))
  log.attempt("QNORM_TRIANGLE", () => sthm(@padics.qnorm_triangle()))
  log.attempt("qadic_metric", () => sthm(@padics.qadic_metric()))
  log.attempt("QADIC_METRIC", () => sthm(@padics.qadic_metric_v1()))
  log.attempt("QADIC_ULTRAMETRIC", () => sthm(@padics.qadic_ultrametric()))
  log.attempt("padic_tybij", () => sthm(@padics.padic_tybij()))
  log.attempt("CARD_EQ_PADIC", () => sthm(@padics.card_eq_padic()))
  log.attempt("prational", () => sthm(@padics.prational()))
  log.attempt("padic_of_rational", () => sthm(@padics.padic_of_rational()))
  log.attempt("rational_of_padic", () => sthm(@padics.rational_of_padic()))
  log.attempt("IMAGE_PADIC_OF_RATIONAL_RATIONAL", () => {
    sthm(@padics.image_padic_of_rational_rational())
  })
  log.attempt("padic_metric", () => sthm(@padics.padic_metric()))
  log.attempt("MSPACE_PADIC_METRIC", () => sthm(@padics.mspace_padic_metric()))
  log.attempt("MCOMPLETE_PADIC_METRIC", () => {
    sthm(@padics.mcomplete_padic_metric())
  })
  log.attempt("padic_topology", () => sthm(@padics.padic_topology()))
  log.attempt("TOPSPACE_PADIC_TOPOLOGY", () => {
    sthm(@padics.topspace_padic_topology())
  })
  log.attempt("HAUSDORFF_SPACE_PADIC_TOPOLOGY", () => {
    sthm(@padics.hausdorff_space_padic_topology())
  })
  log.attempt("CLOSURE_OF_PRATIONAL", () => sthm(@padics.closure_of_prational()))
  log.attempt("DERIVED_SET_OF_PRATIONAL", () => {
    sthm(@padics.derived_set_of_prational())
  })
  log.attempt("pdist", () => sthm(@padics.pdist()))
  log.attempt("PDIST_GEN", () => sthm(@padics.pdist_gen()))
  log.attempt("PDIST", () => sthm(@padics.pdist_v1()))
  log.attempt("PDIST_ALT", () => sthm(@padics.pdist_alt()))
  log.attempt("PDIST_POS_LE", () => sthm(@padics.pdist_pos_le()))
  log.attempt("PDIST_REFL", () => sthm(@padics.pdist_refl()))
  log.attempt("PDIST_SYM", () => sthm(@padics.pdist_sym()))
  log.attempt("PDIST_EQ_0", () => sthm(@padics.pdist_eq_0()))
  log.attempt("PDIST_TRIANGLE", () => sthm(@padics.pdist_triangle()))
  log.attempt("PDIST_ULTRA", () => sthm(@padics.pdist_ultra()))
  log.attempt("CONTINUOUS_MAP_PADIC_ADDITION", () => {
    sthm(@padics.continuous_map_padic_addition())
  })
  log.attempt("PADIC_ADD_OF_RATIONAL", () => {
    sthm(@padics.padic_add_of_rational())
  })
  log.attempt("CONTINUOUS_MAP_PADIC_MULTIPLICATION", () => {
    sthm(@padics.continuous_map_padic_multiplication())
  })
  log.attempt("PADIC_MUL_OF_RATIONAL", () => {
    sthm(@padics.padic_mul_of_rational())
  })
  log.attempt("padic_of_num", () => sthm(@padics.padic_of_num()))
  log.attempt("padic_neg", () => sthm(@padics.padic_neg()))
  log.attempt("padic_sub", () => sthm(@padics.padic_sub()))
  log.attempt("PADIC_NEG_OF_RATIONAL", () => {
    sthm(@padics.padic_neg_of_rational())
  })
  log.attempt("PADIC_SUB_OF_RATIONAL", () => {
    sthm(@padics.padic_sub_of_rational())
  })
  log.attempt("CONTINUOUS_MAP_PADIC_ADD", () => {
    sthm(@padics.continuous_map_padic_add())
  })
  log.attempt("CONTINUOUS_MAP_PADIC_MUL", () => {
    sthm(@padics.continuous_map_padic_mul())
  })
  log.attempt("CONTINUOUS_MAP_PADIC_NEG", () => {
    sthm(@padics.continuous_map_padic_neg())
  })
  log.attempt("CONTINUOUS_MAP_PADIC_SUB", () => {
    sthm(@padics.continuous_map_padic_sub())
  })
  log.attempt("FORALL_IN_PADIC_CLOSURE_OF", () => {
    sthm(@padics.forall_in_padic_closure_of())
  })
  log.attempt("PADIC_ADD_SYM", () => sthm(@padics.padic_add_sym()))
  log.attempt("PADIC_ADD_ASSOC", () => sthm(@padics.padic_add_assoc()))
  log.attempt("PADIC_ADD_LID", () => sthm(@padics.padic_add_lid()))
  log.attempt("PADIC_ADD_LINV", () => sthm(@padics.padic_add_linv()))
  log.attempt("PADIC_MUL_SYM", () => sthm(@padics.padic_mul_sym()))
  log.attempt("PADIC_MUL_ASSOC", () => sthm(@padics.padic_mul_assoc()))
  log.attempt("PADIC_MUL_LID", () => sthm(@padics.padic_mul_lid()))
  log.attempt("PADIC_ADD_LDISTRIB", () => sthm(@padics.padic_add_ldistrib()))
  log.attempt("pnorm", () => sthm(@padics.pnorm()))
  log.attempt("PDIST_PNORM", () => sthm(@padics.pdist_pnorm()))
  log.attempt("PNORM_RATIONAL", () => sthm(@padics.pnorm_rational()))
  log.attempt("PNORM_1", () => sthm(@padics.pnorm_1()))
  log.attempt("PNORM_NEG", () => sthm(@padics.pnorm_neg()))
  log.attempt("PNORM_POS_LE", () => sthm(@padics.pnorm_pos_le()))
  log.attempt("PNORM_0", () => sthm(@padics.pnorm_0()))
  log.attempt("PNORM_EQ_0", () => sthm(@padics.pnorm_eq_0()))
  log.attempt("PNORM_POS_LT", () => sthm(@padics.pnorm_pos_lt()))
  log.attempt("PNORM_ULTRA", () => sthm(@padics.pnorm_ultra()))
  log.attempt("PNORM_TRIANGLE", () => sthm(@padics.pnorm_triangle()))
  log.attempt("PNORM_MUL", () => sthm(@padics.pnorm_mul()))
  log.attempt("PADIC_ENTIRE", () => sthm(@padics.padic_entire()))
  log.attempt("padic_inv", () => sthm(@padics.padic_inv()))
  log.attempt("PADIC_INV_0", () => sthm(@padics.padic_inv_0()))
  log.attempt("PADIC_MUL_RINV", () => sthm(@padics.padic_mul_rinv()))
  log.attempt("PADIC_MUL_LINV", () => sthm(@padics.padic_mul_linv()))
  log.attempt("PNORM_INV", () => sthm(@padics.pnorm_inv()))
  // END generated theorem list
  let tm = @term_syntax.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("(zz_counter : _)")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
      #|Searching with limit 2
      #|Searching with limit 3
