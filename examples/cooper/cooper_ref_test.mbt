// Load-fidelity test for Examples/cooper.ml: replays tools/ocaml_ref/Examples_cooper_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Examples/cooper matches Examples/cooper.ml" {
  @cooper.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Examples/cooper",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Examples/cooper")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("divides", () => sthm(@cooper.divides()))
  log.attempt("INT_DOWN2", () => sthm(@cooper.int_down2()))
  log.attempt("DIVIDES_ADD", () => sthm(@cooper.divides_add()))
  log.attempt("DIVIDES_SUB", () => sthm(@cooper.divides_sub()))
  log.attempt("DIVIDES_ADD_REVR", () => sthm(@cooper.divides_add_revr()))
  log.attempt("DIVIDES_ADD_REVL", () => sthm(@cooper.divides_add_revl()))
  log.attempt("DIVIDES_LMUL", () => sthm(@cooper.divides_lmul()))
  log.attempt("DIVIDES_RNEG", () => sthm(@cooper.divides_rneg()))
  log.attempt("DIVIDES_LNEG", () => sthm(@cooper.divides_lneg()))
  log.attempt("INT_DOWN_MUL_LT", () => sthm(@cooper.int_down_mul_lt()))
  log.attempt("INT_MOD_LEMMA", () => sthm(@cooper.int_mod_lemma()))
  log.attempt("cform_INDUCT", () => sthm(@cooper.cform_induct()))
  log.attempt("cform_RECURSION", () => sthm(@cooper.cform_recursion()))
  log.attempt("interp", () => sthm(@cooper.interp()))
  log.attempt("minusinf", () => sthm(@cooper.minusinf()))
  log.attempt("plusinf", () => sthm(@cooper.plusinf()))
  log.attempt("alldivide", () => sthm(@cooper.alldivide()))
  log.attempt("aset", () => sthm(@cooper.aset()))
  log.attempt("bset", () => sthm(@cooper.bset()))
  log.attempt("INT_EXISTS_CASES", () => sthm(@cooper.int_exists_cases()))
  log.attempt("MINUSINF_LEMMA", () => sthm(@cooper.minusinf_lemma()))
  log.attempt("MINUSINF_REPEATS", () => sthm(@cooper.minusinf_repeats()))
  log.attempt("NOMINIMAL_EQUIV", () => sthm(@cooper.nominimal_equiv()))
  log.attempt("BDISJ_REPEATS_LEMMA", () => sthm(@cooper.bdisj_repeats_lemma()))
  log.attempt("MAINTHM_B", () => sthm(@cooper.mainthm_b()))
  log.attempt("mirror", () => sthm(@cooper.mirror()))
  log.attempt("INTERP_MIRROR_LEMMA", () => sthm(@cooper.interp_mirror_lemma()))
  log.attempt("INTERP_MIRROR", () => sthm(@cooper.interp_mirror()))
  log.attempt("BSET_MIRROR", () => sthm(@cooper.bset_mirror()))
  log.attempt("MINUSINF_MIRROR", () => sthm(@cooper.minusinf_mirror()))
  log.attempt("PLUSINF_MIRROR", () => sthm(@cooper.plusinf_mirror()))
  log.attempt("ALLDIVIDE_MIRROR", () => sthm(@cooper.alldivide_mirror()))
  log.attempt("EXISTS_NEG", () => sthm(@cooper.exists_neg()))
  log.attempt("FORALL_NEG", () => sthm(@cooper.forall_neg()))
  log.attempt("EXISTS_MOD_IMP", () => sthm(@cooper.exists_mod_imp()))
  log.attempt("EXISTS_MOD_EQ", () => sthm(@cooper.exists_mod_eq()))
  log.attempt("MAINTHM_A", () => sthm(@cooper.mainthm_a()))
  log.attempt("EXISTS_MULTIPLE_THM_1", () => {
    sthm(@cooper.exists_multiple_thm_1())
  })
  log.attempt("EXISTS_MULTIPLE_THM", () => sthm(@cooper.exists_multiple_thm()))
  log.attempt("INT_DIVIDES_NUM", () => sthm(@cooper.int_divides_num()))
  // END generated theorem list
  let tm = @term_syntax.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("(zz_counter : _)")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
