// Load-fidelity test for Library/isum.ml: replays tools/ocaml_ref/Library_isum_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Library/isum matches Library/isum.ml" {
  @isum.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/isum",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/isum")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("ISUM_SUPPORT", () => sthm(@isum.isum_support()))
  log.attempt("int_isum", () => sthm(@isum.int_isum()))
  log.attempt("CARD_EQ_ISUM", () => sthm(@isum.card_eq_isum()))
  log.attempt("INT_SUB_POW", () => sthm(@isum.int_sub_pow()))
  log.attempt("ISUM_0", () => sthm(@isum.isum_0()))
  log.attempt("ISUM_ABS", () => sthm(@isum.isum_abs()))
  log.attempt("ISUM_ABS_BOUND", () => sthm(@isum.isum_abs_bound()))
  log.attempt("ISUM_ABS_LE", () => sthm(@isum.isum_abs_le()))
  log.attempt("ISUM_ABS_NUMSEG", () => sthm(@isum.isum_abs_numseg()))
  log.attempt("ISUM_ADD", () => sthm(@isum.isum_add()))
  log.attempt("ISUM_ADD_NUMSEG", () => sthm(@isum.isum_add_numseg()))
  log.attempt("ISUM_ADD_SPLIT", () => sthm(@isum.isum_add_split()))
  log.attempt("ISUM_BIJECTION", () => sthm(@isum.isum_bijection()))
  log.attempt("ISUM_BOUND", () => sthm(@isum.isum_bound()))
  log.attempt("ISUM_BOUND_LT", () => sthm(@isum.isum_bound_lt()))
  log.attempt("ISUM_BOUND_LT_ALL", () => sthm(@isum.isum_bound_lt_all()))
  log.attempt("ISUM_CASES", () => sthm(@isum.isum_cases()))
  log.attempt("ISUM_CLAUSES_LEFT", () => sthm(@isum.isum_clauses_left()))
  log.attempt("ISUM_CLAUSES_NUMSEG", () => sthm(@isum.isum_clauses_numseg()))
  log.attempt("ISUM_CLAUSES_RIGHT", () => sthm(@isum.isum_clauses_right()))
  log.attempt("ISUM_COMBINE_L", () => sthm(@isum.isum_combine_l()))
  log.attempt("ISUM_COMBINE_R", () => sthm(@isum.isum_combine_r()))
  log.attempt("ISUM_CONST", () => sthm(@isum.isum_const()))
  log.attempt("ISUM_CONST_NUMSEG", () => sthm(@isum.isum_const_numseg()))
  log.attempt("ISUM_DELETE", () => sthm(@isum.isum_delete()))
  log.attempt("ISUM_DELETE_CASES", () => sthm(@isum.isum_delete_cases()))
  log.attempt("ISUM_DELTA", () => sthm(@isum.isum_delta()))
  log.attempt("ISUM_DIFF", () => sthm(@isum.isum_diff()))
  log.attempt("ISUM_DIFFS", () => sthm(@isum.isum_diffs()))
  log.attempt("ISUM_EQ", () => sthm(@isum.isum_eq()))
  log.attempt("ISUM_EQ_0", () => sthm(@isum.isum_eq_0()))
  log.attempt("ISUM_EQ_0_NUMSEG", () => sthm(@isum.isum_eq_0_numseg()))
  log.attempt("ISUM_EQ_GENERAL", () => sthm(@isum.isum_eq_general()))
  log.attempt("ISUM_EQ_GENERAL_INVERSES", () => {
    sthm(@isum.isum_eq_general_inverses())
  })
  log.attempt("ISUM_EQ_NUMSEG", () => sthm(@isum.isum_eq_numseg()))
  log.attempt("ISUM_EQ_SUPERSET", () => sthm(@isum.isum_eq_superset()))
  log.attempt("ISUM_GROUP", () => sthm(@isum.isum_group()))
  log.attempt("ISUM_IMAGE", () => sthm(@isum.isum_image()))
  log.attempt("ISUM_IMAGE_GEN", () => sthm(@isum.isum_image_gen()))
  log.attempt("ISUM_IMAGE_LE", () => sthm(@isum.isum_image_le()))
  log.attempt("ISUM_IMAGE_NONZERO", () => sthm(@isum.isum_image_nonzero()))
  log.attempt("ISUM_INCL_EXCL", () => sthm(@isum.isum_incl_excl()))
  log.attempt("ISUM_INJECTION", () => sthm(@isum.isum_injection()))
  log.attempt("ISUM_LE", () => sthm(@isum.isum_le()))
  log.attempt("ISUM_LE_INCLUDED", () => sthm(@isum.isum_le_included()))
  log.attempt("ISUM_LE_NUMSEG", () => sthm(@isum.isum_le_numseg()))
  log.attempt("ISUM_LMUL", () => sthm(@isum.isum_lmul()))
  log.attempt("ISUM_LT", () => sthm(@isum.isum_lt()))
  log.attempt("ISUM_LT_ALL", () => sthm(@isum.isum_lt_all()))
  log.attempt("ISUM_MULTICOUNT", () => sthm(@isum.isum_multicount()))
  log.attempt("ISUM_MULTICOUNT_GEN", () => sthm(@isum.isum_multicount_gen()))
  log.attempt("ISUM_NEG", () => sthm(@isum.isum_neg()))
  log.attempt("ISUM_OFFSET", () => sthm(@isum.isum_offset()))
  log.attempt("ISUM_OFFSET_0", () => sthm(@isum.isum_offset_0()))
  log.attempt("ISUM_PARTIAL_PRE", () => sthm(@isum.isum_partial_pre()))
  log.attempt("ISUM_PARTIAL_SUC", () => sthm(@isum.isum_partial_suc()))
  log.attempt("ISUM_POS_BOUND", () => sthm(@isum.isum_pos_bound()))
  log.attempt("ISUM_POS_EQ_0", () => sthm(@isum.isum_pos_eq_0()))
  log.attempt("ISUM_POS_EQ_0_NUMSEG", () => sthm(@isum.isum_pos_eq_0_numseg()))
  log.attempt("ISUM_POS_LE", () => sthm(@isum.isum_pos_le()))
  log.attempt("ISUM_POS_LE_NUMSEG", () => sthm(@isum.isum_pos_le_numseg()))
  log.attempt("ISUM_RESTRICT", () => sthm(@isum.isum_restrict()))
  log.attempt("ISUM_RESTRICT_SET", () => sthm(@isum.isum_restrict_set()))
  log.attempt("ISUM_RMUL", () => sthm(@isum.isum_rmul()))
  log.attempt("ISUM_SING", () => sthm(@isum.isum_sing()))
  log.attempt("ISUM_SING_NUMSEG", () => sthm(@isum.isum_sing_numseg()))
  log.attempt("ISUM_SUB", () => sthm(@isum.isum_sub()))
  log.attempt("ISUM_SUBSET", () => sthm(@isum.isum_subset()))
  log.attempt("ISUM_SUBSET_SIMPLE", () => sthm(@isum.isum_subset_simple()))
  log.attempt("ISUM_SUB_NUMSEG", () => sthm(@isum.isum_sub_numseg()))
  log.attempt("ISUM_ISUM_RESTRICT", () => sthm(@isum.isum_isum_restrict()))
  log.attempt("ISUM_SUPERSET", () => sthm(@isum.isum_superset()))
  log.attempt("ISUM_SWAP", () => sthm(@isum.isum_swap()))
  log.attempt("ISUM_SWAP_NUMSEG", () => sthm(@isum.isum_swap_numseg()))
  log.attempt("ISUM_TRIV_NUMSEG", () => sthm(@isum.isum_triv_numseg()))
  log.attempt("ISUM_UNION", () => sthm(@isum.isum_union()))
  log.attempt("ISUM_UNIONS_NONZERO", () => sthm(@isum.isum_unions_nonzero()))
  log.attempt("ISUM_UNION_EQ", () => sthm(@isum.isum_union_eq()))
  log.attempt("ISUM_UNION_LZERO", () => sthm(@isum.isum_union_lzero()))
  log.attempt("ISUM_UNION_NONZERO", () => sthm(@isum.isum_union_nonzero()))
  log.attempt("ISUM_UNION_RZERO", () => sthm(@isum.isum_union_rzero()))
  log.attempt("ISUM_ZERO_EXISTS", () => sthm(@isum.isum_zero_exists()))
  log.attempt("REAL_OF_NUM_ISUM", () => sthm(@isum.real_of_num_isum()))
  log.attempt("REAL_OF_NUM_ISUM_NUMSEG", () => {
    sthm(@isum.real_of_num_isum_numseg())
  })
  log.attempt("ISUM_ISUM_PRODUCT", () => sthm(@isum.isum_isum_product()))
  log.attempt("ADMISSIBLE_ISUM", () => sthm(@isum.admissible_isum()))
  log.attempt("INT_SUB_POW_L1", () => sthm(@isum.int_sub_pow_l1()))
  log.attempt("INT_SUB_POW_R1", () => sthm(@isum.int_sub_pow_r1()))
  log.attempt("ISUM_UNIV", () => sthm(@isum.isum_univ()))
  log.attempt("ISUM_CLOSED", () => sthm(@isum.isum_closed()))
  log.attempt("ISUM_RELATED", () => sthm(@isum.isum_related()))
  log.attempt("ISUM_CLOSED_NONEMPTY", () => sthm(@isum.isum_closed_nonempty()))
  log.attempt("ISUM_RELATED_NONEMPTY", () => sthm(@isum.isum_related_nonempty()))
  // END generated theorem list
  let tm = @term_syntax.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("(zz_counter : _)")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
