// Load-fidelity test for Library/primitive.ml: replays tools/ocaml_ref/Library_primitive_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Library/primitive matches Library/primitive.ml" {
  @primitive.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/integer", "Library/isum", "Library/binomial", "Library/iter",
      "Library/prime", "Library/pocklington", "Library/products", "Library/multiplicative",
      "Library/primitive",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/primitive")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("INT_PRIME", () => sthm(@primitive.int_prime()))
  log.attempt("REAL_POLY_DIFF_EXPLICIT", () => {
    sthm(@primitive.real_poly_diff_explicit())
  })
  log.attempt("INT_POLY_DIFF_EXPLICIT", () => {
    sthm(@primitive.int_poly_diff_explicit())
  })
  log.attempt("FINITE_INTSEG_RESTRICT", () => {
    sthm(@primitive.finite_intseg_restrict())
  })
  log.attempt("INT_POLY_LAGRANGE", () => sthm(@primitive.int_poly_lagrange()))
  log.attempt("NUM_LAGRANGE_LEMMA", () => sthm(@primitive.num_lagrange_lemma()))
  log.attempt("COUNT_ORDERS_MODULO_PRIME", () => {
    sthm(@primitive.count_orders_modulo_prime())
  })
  log.attempt("PRIMITIVE_ROOTS_MODULO_PRIME", () => {
    sthm(@primitive.primitive_roots_modulo_prime())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_PRIME", () => {
    sthm(@primitive.primitive_root_modulo_prime())
  })
  log.attempt("COPRIME_1_PLUS_POWER_STEP", () => {
    sthm(@primitive.coprime_1_plus_power_step())
  })
  log.attempt("COPRIME_1_PLUS_POWER", () => {
    sthm(@primitive.coprime_1_plus_power())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_PRIMEPOWS", () => {
    sthm(@primitive.primitive_root_modulo_primepows())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_PRIMEPOW", () => {
    sthm(@primitive.primitive_root_modulo_primepow())
  })
  log.attempt("PRIME_DIVISOR_ORDER_EXISTS", () => {
    sthm(@primitive.prime_divisor_order_exists())
  })
  log.attempt("INJECTIVE_EXP_MODULO_EQ", () => {
    sthm(@primitive.injective_exp_modulo_eq())
  })
  log.attempt("POWER_RESIDUE_MODULO_EQ_ALT", () => {
    sthm(@primitive.power_residue_modulo_eq_alt())
  })
  log.attempt("POWER_RESIDUE_MODULO_EQ", () => {
    sthm(@primitive.power_residue_modulo_eq())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_2", () => {
    sthm(@primitive.primitive_root_modulo_2())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_4", () => {
    sthm(@primitive.primitive_root_modulo_4())
  })
  log.attempt("PRIMITIVE_ROOT_DOUBLE_LEMMA", () => {
    sthm(@primitive.primitive_root_double_lemma())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_DOUBLE_PRIMEPOW", () => {
    sthm(@primitive.primitive_root_modulo_double_primepow())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_0", () => {
    sthm(@primitive.primitive_root_modulo_0())
  })
  log.attempt("PRIMITIVE_ROOT_MODULO_1", () => {
    sthm(@primitive.primitive_root_modulo_1())
  })
  log.attempt("CONG_TO_1_POW2", () => sthm(@primitive.cong_to_1_pow2()))
  log.attempt("NO_PRIMITIVE_ROOT_MODULO_POW2", () => {
    sthm(@primitive.no_primitive_root_modulo_pow2())
  })
  log.attempt("NO_PRIMITIVE_ROOT_MODULO_COMPOSITE", () => {
    sthm(@primitive.no_primitive_root_modulo_composite())
  })
  log.attempt("PRIMITIVE_ROOT_EXISTS", () => {
    sthm(@primitive.primitive_root_exists())
  })
  log.attempt("PRIMITIVE_ROOT_EXISTS_NONTRIVIAL", () => {
    sthm(@primitive.primitive_root_exists_nontrivial())
  })
  log.attempt("COUNT_PRIMITIVE_ROOTS_ALT", () => {
    sthm(@primitive.count_primitive_roots_alt())
  })
  log.attempt("COUNT_PRIMITIVE_ROOTS", () => {
    sthm(@primitive.count_primitive_roots())
  })
  log.attempt("COUNT_ROOTS_MODULO_PRIMITIVE_GEN_ALT", () => {
    sthm(@primitive.count_roots_modulo_primitive_gen_alt())
  })
  log.attempt("COUNT_ROOTS_MODULO_PRIMITIVE_GEN", () => {
    sthm(@primitive.count_roots_modulo_primitive_gen())
  })
  log.attempt("POWER_RESIDUE_MODULO_PRIMITIVE", () => {
    sthm(@primitive.power_residue_modulo_primitive())
  })
  log.attempt("POWER_RESIDUE_MODULO_PRIME_EQ", () => {
    sthm(@primitive.power_residue_modulo_prime_eq())
  })
  log.attempt("POWER_RESIDUE_MODULO_PRIMITIVE_ORDER_ALT", () => {
    sthm(@primitive.power_residue_modulo_primitive_order_alt())
  })
  log.attempt("POWER_RESIDUE_MODULO_PRIMITIVE_ORDER", () => {
    sthm(@primitive.power_residue_modulo_primitive_order())
  })
  log.attempt("QUADRATIC_RESIDUE_MODULO_PRIMITIVE_ORDER", () => {
    sthm(@primitive.quadratic_residue_modulo_primitive_order())
  })
  log.attempt("POWER_RESIDUE_MODULO_PRIMITIVE_POWER", () => {
    sthm(@primitive.power_residue_modulo_primitive_power())
  })
  log.attempt("QUADRATIC_RESIDUE_MODULO_PRIMITIVE_POWER", () => {
    sthm(@primitive.quadratic_residue_modulo_primitive_power())
  })
  log.attempt("COUNT_POWER_RESIDUES_MODULO_PRIMITIVE", () => {
    sthm(@primitive.count_power_residues_modulo_primitive())
  })
  log.attempt("COUNT_QUADRATIC_RESIDUES_MODULO_PRIMITIVE", () => {
    sthm(@primitive.count_quadratic_residues_modulo_primitive())
  })
  log.attempt("INT_OF_NUM_POWER_RESIDUE", () => {
    sthm(@primitive.int_of_num_power_residue())
  })
  log.attempt("QUADRATIC_RESIDUE_MODULO_ODD_POWER", () => {
    sthm(@primitive.quadratic_residue_modulo_odd_power())
  })
  log.attempt("QUADRATIC_RESIDUE_MODULO_POWER_2_STABLE", () => {
    sthm(@primitive.quadratic_residue_modulo_power_2_stable())
  })
  log.attempt("QUADRATIC_RESIDUE_MODULO_POWER_2", () => {
    sthm(@primitive.quadratic_residue_modulo_power_2())
  })
  log.attempt("GENERALIZED_EULER_CRITERION", () => {
    sthm(@primitive.generalized_euler_criterion())
  })
  log.attempt("GENERALIZED_EULER_CRITERION_PRIME", () => {
    sthm(@primitive.generalized_euler_criterion_prime())
  })
  log.attempt("EULER_CRITERION", () => sthm(@primitive.euler_criterion()))
  log.attempt("COUNT_ROOTS_MODULO_ODD_GEN", () => {
    sthm(@primitive.count_roots_modulo_odd_gen())
  })
  log.attempt("COUNT_ROOTS_MODULO_ODD_ALT_GEN", () => {
    sthm(@primitive.count_roots_modulo_odd_alt_gen())
  })
  log.attempt("POWER_RESIDUE_MODULO_ODD", () => {
    sthm(@primitive.power_residue_modulo_odd())
  })
  log.attempt("COUNT_ROOTS_MODULO_PRIMITIVE_ALT", () => {
    sthm(@primitive.count_roots_modulo_primitive_alt())
  })
  log.attempt("COUNT_ROOTS_MODULO_PRIMITIVE", () => {
    sthm(@primitive.count_roots_modulo_primitive())
  })
  log.attempt("COUNT_ROOTS_MODULO_ODD_ALT", () => {
    sthm(@primitive.count_roots_modulo_odd_alt())
  })
  log.attempt("COUNT_ROOTS_MODULO_ODD", () => {
    sthm(@primitive.count_roots_modulo_odd())
  })
  log.attempt("POWER_RESIDUE_EXISTS", () => {
    sthm(@primitive.power_residue_exists())
  })
  log.attempt("QUADRATIC_NONRESIDUE_EXISTS", () => {
    sthm(@primitive.quadratic_nonresidue_exists())
  })
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
      #|Searching with limit 0
      #|Searching with limit 1
