// Load-fidelity test for Library/floor.ml: replays tools/ocaml_ref/Library_floor_ref.ml
// (keep in sync; refresh with tools/ocaml_ref/refresh_ref.py).

///|
using @testkit {stm, sthm}

///|
test "Library/floor matches Library/floor.ml" {
  @floor.load()
  let log = @testkit.Log::new()
  log.capture_reports()
  for
    th in [
      "simp", "theorems", "ind_defs", "class", "trivia", "canon", "meson", "firstorder",
      "metis", "thecops", "quot", "impconv", "pair", "compute", "nums", "recursion",
      "arith", "wf", "calc_num", "normalizer", "grobner", "ind_types", "lists", "realax",
      "calc_int", "realarith", "real", "calc_rat", "int", "sets", "iterate", "cart",
      "define", "Library/floor",
    ] {
    log.show_theory_output(th)
  }
  log.show_theory_trace("Library/floor")
  log.capture_stdout()
  // BEGIN generated theorem list
  log.attempt("INTEGER_CASES", () => sthm(@floor.integer_cases()))
  log.attempt("REAL_ABS_INTEGER_LEMMA", () => {
    sthm(@floor.real_abs_integer_lemma())
  })
  log.attempt("INTEGER_CLOSED", () => sthm(@floor.integer_closed()))
  log.attempt("INTEGER_ADD", () => sthm(@floor.integer_add()))
  log.attempt("INTEGER_SUB", () => sthm(@floor.integer_sub()))
  log.attempt("INTEGER_MUL", () => sthm(@floor.integer_mul()))
  log.attempt("INTEGER_POW", () => sthm(@floor.integer_pow()))
  log.attempt("REAL_LE_INTEGERS", () => sthm(@floor.real_le_integers()))
  log.attempt("REAL_LE_CASES_INTEGERS", () => {
    sthm(@floor.real_le_cases_integers())
  })
  log.attempt("REAL_LE_REVERSE_INTEGERS", () => {
    sthm(@floor.real_le_reverse_integers())
  })
  log.attempt("REAL_LT_INTEGERS", () => sthm(@floor.real_lt_integers()))
  log.attempt("REAL_EQ_INTEGERS", () => sthm(@floor.real_eq_integers()))
  log.attempt("REAL_EQ_INTEGERS_IMP", () => sthm(@floor.real_eq_integers_imp()))
  log.attempt("INTEGER_NEG", () => sthm(@floor.integer_neg()))
  log.attempt("INTEGER_ABS", () => sthm(@floor.integer_abs()))
  log.attempt("INTEGER_POS", () => sthm(@floor.integer_pos()))
  log.attempt("NONNEGATIVE_INTEGER", () => sthm(@floor.nonnegative_integer()))
  log.attempt("NONPOSITIVE_INTEGER", () => sthm(@floor.nonpositive_integer()))
  log.attempt("NONPOSITIVE_INTEGER_ALT", () => {
    sthm(@floor.nonpositive_integer_alt())
  })
  log.attempt("INTEGER_ADD_EQ", () => sthm(@floor.integer_add_eq()))
  log.attempt("INTEGER_SUB_EQ", () => sthm(@floor.integer_sub_eq()))
  log.attempt("FORALL_INTEGER", () => sthm(@floor.forall_integer()))
  log.attempt("INTEGER_SUM", () => sthm(@floor.integer_sum()))
  log.attempt("INTEGER_ABS_MUL_EQ_1", () => sthm(@floor.integer_abs_mul_eq_1()))
  log.attempt("INTEGER_DIV", () => sthm(@floor.integer_div()))
  log.attempt("rational", () => sthm(@floor.rational()))
  log.attempt("RATIONAL_INTEGER", () => sthm(@floor.rational_integer()))
  log.attempt("RATIONAL_NUM", () => sthm(@floor.rational_num()))
  log.attempt("RATIONAL_NEG", () => sthm(@floor.rational_neg()))
  log.attempt("RATIONAL_ABS", () => sthm(@floor.rational_abs()))
  log.attempt("RATIONAL_INV", () => sthm(@floor.rational_inv()))
  log.attempt("RATIONAL_ADD", () => sthm(@floor.rational_add()))
  log.attempt("RATIONAL_SUB", () => sthm(@floor.rational_sub()))
  log.attempt("RATIONAL_MUL", () => sthm(@floor.rational_mul()))
  log.attempt("RATIONAL_DIV", () => sthm(@floor.rational_div()))
  log.attempt("RATIONAL_POW", () => sthm(@floor.rational_pow()))
  log.attempt("RATIONAL_CLOSED", () => sthm(@floor.rational_closed()))
  log.attempt("RATIONAL_NEG_EQ", () => sthm(@floor.rational_neg_eq()))
  log.attempt("RATIONAL_ABS_EQ", () => sthm(@floor.rational_abs_eq()))
  log.attempt("RATIONAL_INV_EQ", () => sthm(@floor.rational_inv_eq()))
  log.attempt("RATIONAL_SUM", () => sthm(@floor.rational_sum()))
  log.attempt("RATIONAL_ALT", () => sthm(@floor.rational_alt()))
  log.attempt("REAL_TRUNCATE_POS", () => sthm(@floor.real_truncate_pos()))
  log.attempt("REAL_TRUNCATE", () => sthm(@floor.real_truncate()))
  log.attempt("FLOOR_FRAC", () => sthm(@floor.floor_frac()))
  log.attempt("FLOOR_UNIQUE", () => sthm(@floor.floor_unique()))
  log.attempt("FLOOR_EQ_0", () => sthm(@floor.floor_eq_0()))
  log.attempt("FLOOR", () => sthm(@floor.floor()))
  log.attempt("FLOOR_DOUBLE", () => sthm(@floor.floor_double()))
  log.attempt("FRAC_FLOOR", () => sthm(@floor.frac_floor()))
  log.attempt("FLOOR_NUM", () => sthm(@floor.floor_num()))
  log.attempt("REAL_LE_FLOOR", () => sthm(@floor.real_le_floor()))
  log.attempt("REAL_FLOOR_LE", () => sthm(@floor.real_floor_le()))
  log.attempt("REAL_FLOOR_LT", () => sthm(@floor.real_floor_lt()))
  log.attempt("REAL_LT_FLOOR", () => sthm(@floor.real_lt_floor()))
  log.attempt("FLOOR_POS", () => sthm(@floor.floor_pos()))
  log.attempt("FLOOR_DIV_DIV", () => sthm(@floor.floor_div_div()))
  log.attempt("FLOOR_MONO", () => sthm(@floor.floor_mono()))
  log.attempt("REAL_FLOOR_EQ", () => sthm(@floor.real_floor_eq()))
  log.attempt("REAL_FLOOR_LT_REFL", () => sthm(@floor.real_floor_lt_refl()))
  log.attempt("REAL_FRAC_EQ_0", () => sthm(@floor.real_frac_eq_0()))
  log.attempt("REAL_FRAC_POS_LT", () => sthm(@floor.real_frac_pos_lt()))
  log.attempt("FRAC_NUM", () => sthm(@floor.frac_num()))
  log.attempt("REAL_FLOOR_REFL", () => sthm(@floor.real_floor_refl()))
  log.attempt("REAL_FRAC_ZERO", () => sthm(@floor.real_frac_zero()))
  log.attempt("REAL_FLOOR_ADD", () => sthm(@floor.real_floor_add()))
  log.attempt("REAL_FLOOR_TRIANGLE", () => sthm(@floor.real_floor_triangle()))
  log.attempt("REAL_FLOOR_NEG", () => sthm(@floor.real_floor_neg()))
  log.attempt("REAL_FRAC_ADD", () => sthm(@floor.real_frac_add()))
  log.attempt("FLOOR_POS_LE", () => sthm(@floor.floor_pos_le()))
  log.attempt("FRAC_UNIQUE", () => sthm(@floor.frac_unique()))
  log.attempt("REAL_FRAC_EQ", () => sthm(@floor.real_frac_eq()))
  log.attempt("INTEGER_ROUND", () => sthm(@floor.integer_round()))
  log.attempt("FRAC_DIV_MOD", () => sthm(@floor.frac_div_mod()))
  log.attempt("FRAC_NEG", () => sthm(@floor.frac_neg()))
  log.attempt("REAL_FLOOR_FLOOR_DIV", () => sthm(@floor.real_floor_floor_div()))
  log.attempt("INTEGER_EXISTS_BETWEEN_ALT", () => {
    sthm(@floor.integer_exists_between_alt())
  })
  log.attempt("INTEGER_EXISTS_BETWEEN_LT", () => {
    sthm(@floor.integer_exists_between_lt())
  })
  log.attempt("INTEGER_EXISTS_BETWEEN", () => {
    sthm(@floor.integer_exists_between())
  })
  log.attempt("INTEGER_EXISTS_BETWEEN_ABS", () => {
    sthm(@floor.integer_exists_between_abs())
  })
  log.attempt("INTEGER_EXISTS_BETWEEN_ABS_LT", () => {
    sthm(@floor.integer_exists_between_abs_lt())
  })
  log.attempt("REAL_OF_INT_OF_REAL", () => sthm(@floor.real_of_int_of_real()))
  log.attempt("IMAGE_REAL_OF_INT_UNIV", () => {
    sthm(@floor.image_real_of_int_univ())
  })
  log.attempt("HAS_SIZE_INTSEG_NUM", () => sthm(@floor.has_size_intseg_num()))
  log.attempt("FINITE_INTSEG", () => sthm(@floor.finite_intseg()))
  log.attempt("HAS_SIZE_INTSEG_INT", () => sthm(@floor.has_size_intseg_int()))
  log.attempt("CARD_INTSEG_INT", () => sthm(@floor.card_intseg_int()))
  log.attempt("REAL_CARD_INTSEG_INT", () => sthm(@floor.real_card_intseg_int()))
  log.attempt("INFINITE_INTEGER", () => sthm(@floor.infinite_integer()))
  log.attempt("INFINITE_RATIONAL", () => sthm(@floor.infinite_rational()))
  log.attempt("PADIC_RATIONAL_APPROXIMATION_STRADDLE", () => {
    sthm(@floor.padic_rational_approximation_straddle())
  })
  log.attempt("PADIC_RATIONAL_APPROXIMATION_STRADDLE_POS", () => {
    sthm(@floor.padic_rational_approximation_straddle_pos())
  })
  log.attempt("PADIC_RATIONAL_APPROXIMATION_STRADDLE_POS_LE", () => {
    sthm(@floor.padic_rational_approximation_straddle_pos_le())
  })
  log.attempt("RATIONAL_APPROXIMATION", () => {
    sthm(@floor.rational_approximation())
  })
  log.attempt("RATIONAL_BETWEEN", () => sthm(@floor.rational_between()))
  log.attempt("RATIONAL_BETWEEN_EQ", () => sthm(@floor.rational_between_eq()))
  log.attempt("RATIONAL_APPROXIMATION_STRADDLE", () => {
    sthm(@floor.rational_approximation_straddle())
  })
  log.attempt("RATIONAL_APPROXIMATION_ABOVE", () => {
    sthm(@floor.rational_approximation_above())
  })
  log.attempt("RATIONAL_APPROXIMATION_BELOW", () => {
    sthm(@floor.rational_approximation_below())
  })
  log.attempt("INFINITE_RATIONAL_IN_RANGE", () => {
    sthm(@floor.infinite_rational_in_range())
  })
  log.attempt("REAL_CONGRUENCE", () => sthm(@floor.real_congruence()))
  log.attempt("REAL_INT_CONGRUENCE", () => sthm(@floor.real_int_congruence()))
  // END generated theorem list
  let tm = @parser.parse_term
  log.attempt("types", () => {
    @kernel.types().map(p => p.0 + "/" + p.1.to_string()).to_array().join(" ")
  })
  log.attempt("constants", () => {
    @kernel.constants().map(c => c.0).to_array().join(" ")
  })
  log.attempt("definitions", () => @kernel.definitions().length().to_string())
  // BEGIN EXTRA
  // END EXTRA
  log.attempt("counter_tyvar", () => stm(tm("zz_counter")))
  log.attempt("counter_genvar", () => stm(@basics.genvar(@kernel.bool_ty)))
  @testkit.check_axioms()
  inspect(
    @testkit.normalize_times(log.contents()),
    content=(
